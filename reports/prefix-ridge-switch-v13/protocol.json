  "ridge": {
    "features": "Exactly external_benchmark/evaluate.py features: known controller-target mean displacement and affine moments normalized by initial node span, plus attachment_active",
    "regularization": 0.1,
    "intercept_regularized": true,
    "standardization": "training-prefix mean/std; std<1e-5 replaced1",
    "interpolation": "same observed-initial six-neighbor RBF formula, evaluated on mechanical nodes; original dense-support baseline differs by subsequent nodal expansion, explicitly report as nodal position-ridge candidate",
    "no_hyperparameter_search": true,
    "label": "guarded_nodal_position_ridge; retain archived raw support-space position_ridge separately",
    "equivalence": "Do not claim marker\u2192node\u2192support equals direct marker\u2192support. Verify fixed feature/coefficient/RBF formula equivalence on same requested output locations; report nodal/guard difference explicitly."
  },
  "validation": {
    "full_end": "existing observed train_end",
    "cut": "max(3,int(train_end*.7)); require2<=cut<train_end",
    "data": "firstcutobservations train;[cut,train_end) observed positions/masks score; future known controller commands allowed; no object suffix/manual targets",
    "metric": "coordinate RMS on same observed points using existing _observed_prediction projection for both candidates",
    "old_candidate": "reconstruct exactly metadata.selected_configuration using independently SHORT-fit cached current/field_free anchor or short rigid, same _predict and local-J guard; never use FULL-fit predictions on validation",
    "rule": "switch only finite ridge score<.98*old score, deterministic default otherwise; finite ridge versus infinite old is allowed if old reconstruction is available; missing/reconstruction error/invalid cut => unchanged old",
    "reuse_validation_warning": "Original family choice also used this prefix holdout; this is additional exploratory validation reuse"
  },
  "postprocessing": {
    "proposal": "Fixed-feature nodal ridge proposal, passed through unchanged feasibility.repair using current-family independently SHORT-fit FEM anchor during validation and current FULL-fit FEM anchor for final forecast. Guarded empirical hybrid; not raw ridge or elastic inference.",
    "common_checks": "Identical feasibility.repair(localtetJ) then SoftVT scene rollout then postcontact J>.03+1e-8 checks as archived selector. Invalid FEM anchor or ridge proposal is explicit candidate failure, never raw-ridge bypass. Every validation frame must be finite/valid.",
    "SoftVT": "Same static-scene contact rollout after same feasibility repair; explicitly scene-conditioned guarded nodal ridge.",
    "PhysTwin": "No scene rollout, same nodal topology/finite checks",
    "full_failure": "If selected ridge full-prefix forecast fails, retain NaN/failure frame, never future-conditioned fallback. Otherwise unchanged-default branch is byte-exact archived model_selection_selected."
  },
  "safe_inputs": {
    "SoftVT": "New prefix-only HDF exporter reads initial geometry and observed[:train_end], known robot/controller streams; recompute SHORT grasp/attachment geometry and normalization on SHORT prefix. Never read future deformable nodes.",
    "PhysTwin": "Monolithic upstream pickle necessitates quarantined export process: extract initial geometry, allowedprefix points/visibilities/validity and known controller streams, drop future object arrays; predictor only receives persisted strict safe payload. Explicitly acknowledge raw file contains evaluator data; future-object mutation test must leave payload/selection/forecast unchanged.",
    "forbidden": "evaluation dictionaries/manual tracks/future object points in predictor; final scoring separate process after all forecast files and sourcefreeze"
